      <property name="styleSheet">
       <string notr="true">
     QMainWindow {
         background-color: #FFFFFF;
         border-radius: 10px;
     }
     QMainWindow[darkTheme=&quot;true&quot;] {
         background-color: #000000;
     }
     QGroupBox {
         background-color: #FFFFFF;
         border: 2px solid #7D4FEE;
         border-radius: 10px;
         font: bold 14pt &quot;Arial&quot;;
         color: #7D4FEE;
         margin: 10px;
     }
     QGroupBox[darkTheme=&quot;true&quot;] {
         background-color: #000000;
         border: 2px solid #7D4FEE;
         color: #7D4FEE;
     }
     QGroupBox::title {
         color: #7D4FEE;
         padding: 0 5px;
         subcontrol-origin: margin;
         subcontrol-position: top left;
     }
     QPushButton {
         background-color: #7D4FEE;
         color: #FFFFFF;
         border-radius: 10px;
         padding: 8px;
         min-width: 100px;
         font: 10pt &quot;Arial&quot;;
         border: 2px solid #7D4FEE;
     }
     QPushButton:hover {
         background-color: #FFFFFF;
         color: #7D4FEE;
         border: 2px solid #7D4FEE;
     }
     QLineEdit, QComboBox, QSpinBox, QDateEdit {
         background-color: #FFFFFF;
         border: 2px solid #7D4FEE;
         border-radius: 10px;
         padding: 6px;
         font: 10pt &quot;Arial&quot;;
         color: #7D4FEE;
     }
     QLineEdit[darkTheme=&quot;true&quot;], QComboBox[darkTheme=&quot;true&quot;], QSpinBox[darkTheme=&quot;true&quot;], QDateEdit[darkTheme=&quot;true&quot;] {
         background-color: #000000;
         border: 2px solid #7D4FEE;
         color: #7D4FEE;
     }
     QTableWidget {
         background-color: #FFFFFF;
         border: 2px solid #7D4FEE;
         border-radius: 10px;
         gridline-color: #7D4FEE;
         font: 10pt &quot;Arial&quot;;
         color: #7D4FEE;
     }
     QTableWidget[darkTheme=&quot;true&quot;] {
         background-color: #1A1A1A;
         border: 2px solid #7D4FEE;
         color: #7D4FEE;
     }
     QTableWidget::item:selected {
         background-color: #7D4FEE;
         color: #FFFFFF;
     }
     QLabel {
         color: #7D4FEE;
         font: 10pt &quot;Arial&quot;;
     }
     QLabel[darkTheme=&quot;true&quot;] {
         color: #7D4FEE;
     }
     QWidget#sidebar {
         background-color: #7D4FEE;
         border-radius: 10px 0 0 10px;
     }
     QPushButton#sidebarButton {
         background-color: #7D4FEE;
         color: #FFFFFF;
         border: none;
         border-radius: 10px;
         padding: 10px;
         font: 10pt &quot;Arial&quot;;
         width: 100%;
         text-align: left;
     }
     QPushButton#sidebarButton:hover {
         background-color: #FFFFFF;
         color: #7D4FEE;
         border: 2px solid #7D4FEE;
     }
QFrame#menuFrame {
    background-color: white;
}

