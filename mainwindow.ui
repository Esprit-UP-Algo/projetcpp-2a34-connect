        <property name="styleSheet">
         <string notr="true">QTabWidget::pane {
    background: white;
}
/* Fond global du QTabWidget */
QTabWidget {
    background: white;
}

/* Zone principale (pages internes) */
QTabWidget::pane {
    background: white;
    border: 1px solid #ccc;
    border-radius: 6px;
}

/* Onglets */
QTabBar::tab {
    background: white;
    color: black;
    padding: 6px 12px;
    border: 1px solid #ccc;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

/* Onglet sélectionné */
QTabBar::tab:selected {
    background: #f2f2f2;
    color: black;
}

/* Onglet survolé */
QTabBar::tab:hover {
    background: #e6e6e6;
}

</string>
