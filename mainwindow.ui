          <property name="styleSheet">
           <string notr="true"># Définir une classe CSS réutilisable
STYLE_SHEET = &quot;&quot;&quot;
    .large-text {
        font-size: 16px;
        font-family: Segoe UI, Arial;
    }
    
    .response-area {
        font-size: 15px;
        background-color: #e8f4f8;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }
&quot;&quot;&quot;
# Au lieu de ça :
self.setStyleSheet(&quot;font-size: 16px;&quot;)

# Essayez ça :
self.setStyleSheet(&quot;&quot;&quot;
    QWidget {
        font-size: 16px;
        font-family: Arial;
    }
    QLabel, QLineEdit, QTextEdit, QPushButton {
        font-size: 16px;
    }
&quot;&quot;&quot;)

self.setStyleSheet(STYLE_SHEET)

# Appliquer aux widgets
self.line_edit.setProperty(&quot;class&quot;, &quot;large-text&quot;)
self.response_label.setProperty(&quot;class&quot;, &quot;response-area&quot;)</string>
          </property>
          <property name="text">
