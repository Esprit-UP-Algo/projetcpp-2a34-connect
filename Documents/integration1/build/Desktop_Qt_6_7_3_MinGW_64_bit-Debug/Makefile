	$(MAKE) $(MAKESILENT) -f CMakeFiles\interface23.dir\build.make CMakeFiles/interface23.dir/sponsor.cpp.obj
.PHONY : sponsor.cpp.obj

sponsor.i: sponsor.cpp.i
.PHONY : sponsor.i

# target to preprocess a source file
sponsor.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\interface23.dir\build.make CMakeFiles/interface23.dir/sponsor.cpp.i
.PHONY : sponsor.cpp.i

sponsor.s: sponsor.cpp.s
.PHONY : sponsor.s

# target to generate assembly for a file
sponsor.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles\interface23.dir\build.make CMakeFiles/interface23.dir/sponsor.cpp.s
.PHONY : sponsor.cpp.s

